{
  "name": "triangle-packing-atlas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites.js",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "benchmark": "node benchmarks/run.js",
    "atlas:verify": "node cli/verify.js",
    "atlas:benchmark": "node benchmarks/atlas.js",
    "atlas:submission-benchmark": "node benchmarks/submission.js",
    "atlas:release": "node scripts/build-atlas-release.js",
    "atlas:research": "node scripts/build-research-release.js",
    "atlas:v2": "node scripts/build-v2-release.js",
    "atlas:experiment": "node cli/experiment.js",
    "atlas:audit": "node scripts/audit-v2-release.js",
    "atlas:challenges": "node scripts/build-community-challenges.js",
    "atlas:adaptive": "node benchmarks/adaptive.js",
    "atlas:freeze": "node scripts/freeze-v2-release.js",
    "atlas:submission": "node cli/submission.js",
    "atlas:submission-verify": "node cli/verify-submission-bundle.js",
    "atlas:report": "node cli/report.js",
    "atlas:archive": "sh scripts/package-archive.sh",
    "atlas:archive-audit": "node scripts/audit-v2-archive.js",
    "atlas:cross-verify": "python3 independent_verifier/verify_release.py public/atlas-v2.json",
    "atlas:certificate": "node cli/certificates.js",
    "atlas:beta": "node scripts/community-beta.js",
    "atlas:v1-rc": "sh scripts/package-v1-rc.sh",
    "check": "npm test && npm run atlas:v2 && npm run atlas:audit && npm run atlas:cross-verify && npm run atlas:beta && npm run atlas:challenges && npm run atlas:archive-audit && npm run build"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
