{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trianglepackingatlas.org/schemas/problem.v1.json",
  "title": "Triangle Packing Atlas Problem",
  "type": "object",
  "required": ["name", "width", "height", "triangles"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "margin": { "type": "number", "minimum": 0, "default": 0 },
    "kerf": { "type": "number", "minimum": 0, "default": 0 },
    "allowRotation": { "type": "boolean", "default": true },
    "allowReflection": { "type": "boolean", "default": false },
    "fillSheet": { "type": "boolean", "default": false },
    "maxPieces": { "type": "integer", "minimum": 1, "maximum": 300 },
    "seed": { "type": "string" },
    "triangles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sides"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sides": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "color": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
