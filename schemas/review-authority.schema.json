{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trianglepackingatlas.org/schemas/review-authority.v1.json",
  "title": "Triangle Packing Atlas public review authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "updatedAt", "keys", "sha256"],
  "properties": {
    "format": { "const": "triangle-packing-review-authority/v1" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "reviewer", "roles", "activeFrom", "expiresAt", "revokedAt", "publicKeyPem"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 2 },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["reviewer", "proof_reviewer", "maintainer"] } },
          "activeFrom": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": ["string", "null"], "format": "date-time" },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
        }
      }
    }
  }
}
