{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trianglepackingatlas.org/schemas/canonical-release.v2.json",
  "title": "Triangle Packing Atlas canonical release",
  "type": "object",
  "required": ["format", "version", "releasedAt", "verificationPolicy", "coverage", "transitions", "records"],
  "properties": {
    "format": { "const": "triangle-packing-atlas/v2" },
    "version": { "const": "2.0.0" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "license": { "const": "CC-BY-4.0" },
    "coverage": {
      "type": "object",
      "required": ["records", "verified", "provenOptimal", "openDistributedTasks", "phaseTransitions"]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "experimentId", "family", "parameters", "problem", "solution", "evidence", "verification", "bounds", "solver", "provenance", "history", "reproducibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "experimentId": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["state", "claim", "reviewed", "citations"]
          },
          "verification": {
            "type": "object",
            "required": ["valid", "fingerprint", "certificate", "verifier", "tolerancePolicy"]
          },
          "reproducibility": {
            "type": "object",
            "required": ["command", "deterministic", "seed", "algorithmVersion"]
          }
        }
      }
    }
  }
}
