{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trianglepackingatlas.org/schemas/contribution-ledger.v1.json",
  "title": "Triangle Packing Atlas contribution quarantine ledger",
  "type": "object",
  "required": ["format", "issuedAt", "entries", "sha256"],
  "properties": {
    "format": { "const": "triangle-packing-contribution-ledger/v1" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "candidateSha256", "state", "scientificReviewRequired", "events"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "state": { "enum": ["quarantined_for_review", "approved_for_promotion", "rejected_by_review", "rejected_automatically"] },
          "scientificReviewRequired": { "type": "boolean" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "reviewer", "decidedAt", "decision", "authorization", "previousSha256", "sha256"],
              "properties": {
                "type": { "const": "maintainer_review" },
                "decision": { "enum": ["approve", "reject"] },
                "authorization": {
                  "oneOf": [
                    { "type": "object", "required": ["mode", "keyId", "authoritySha256", "ledgerSha256", "signature"],
                      "properties": { "mode": { "const": "ed25519" } } },
                    { "type": "object", "required": ["mode", "cutoff"],
                      "properties": { "mode": { "const": "unsigned_migration" } } }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
